<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <include layout="@layout/item_header" />
        <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="TextView: nhãn" android:textSize="18sp" />
        <EditText android:id="@+id/edtName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="EditText: nhập tên" android:inputType="text" />
        <Button android:id="@+id/btnShow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Button: Hiện tên" />
        <ImageButton android:id="@+id/imgBtn" android:layout_width="64dp" android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_camera" android:contentDescription="Camera" />
        <ImageView android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center"
            android:src="@mipmap/ic_launcher" android:contentDescription="Logo" />
    </LinearLayout>
</ScrollView>