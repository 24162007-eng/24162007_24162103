<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tanh_surface"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="Trang chủ"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabHome"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_indicator"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_tab_home"
            android:tint="@color/tanh_muted" />

        <TextView
            android:id="@+id/tvTabHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="Trang chủ"
            android:textColor="@color/tanh_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabCart"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="Giỏ hàng"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabCart"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_indicator"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_tab_cart"
            android:tint="@color/tanh_muted" />

        <TextView
            android:id="@+id/tvTabCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="Giỏ hàng"
            android:textColor="@color/tanh_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="Hồ sơ"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabProfile"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_indicator"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_tab_profile"
            android:tint="@color/tanh_muted" />

        <TextView
            android:id="@+id/tvTabProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="Hồ sơ"
            android:textColor="@color/tanh_muted"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>