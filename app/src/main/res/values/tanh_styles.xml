<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Tanh" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tanh_primary</item>
        <item name="colorOnPrimary">@color/tanh_surface</item>
        <item name="colorPrimaryContainer">@color/tanh_soft</item>
        <item name="colorOnPrimaryContainer">@color/tanh_primary_dark</item>

        <item name="colorSecondary">@color/tanh_primary</item>
        <item name="colorSecondaryContainer">@color/tanh_soft</item>
        <item name="colorOnSecondaryContainer">@color/tanh_primary_dark</item>

        <item name="colorSurface">@color/tanh_surface</item>
        <item name="colorOnSurface">@color/tanh_ink</item>
        <item name="colorOnSurfaceVariant">@color/tanh_muted</item>
        <item name="colorOutline">@color/tanh_line</item>

        <item name="android:colorBackground">@color/tanh_canvas</item>
        <item name="android:windowBackground">@color/tanh_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.Tanh.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tanh_primary</item>
        <item name="android:textColor">@color/tanh_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Tanh.Button.Tonal"
        parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/tanh_soft</item>
        <item name="android:textColor">@color/tanh_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Tanh.Button.Text"
        parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/tanh_muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Tanh.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/tanh_primary</item>
        <item name="strokeColor">@color/tanh_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Tanh.Card"
        parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tanh_surface</item>
        <item name="strokeColor">@color/tanh_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Tanh.Input"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/tanh_primary</item>
    </style>

</resources>